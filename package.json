{
  "name": "skip-echo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "eval:prepare": "node scripts/prepare-eval.mjs",
    "eval:score": "node scripts/score-eval.mjs",
    "eval:native": "claude plugin eval . --ablation with-without --runs 3 --max-cost-usd 5",
    "eval:hard": "claude plugin eval . --eval-dir evals/hard --ablation with-without --runs 3 --max-cost-usd 10",
    "eval:conditions": "claude plugin eval . --eval-dir evals/conditions --ablation none --runs 3 --max-cost-usd 8",
    "eval:summary": "node scripts/summarize-native.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/revo1290/skip-echo.git"
  },
  "homepage": "https://github.com/revo1290/skip-echo#readme",
  "bugs": {
    "url": "https://github.com/revo1290/skip-echo/issues"
  }
}
